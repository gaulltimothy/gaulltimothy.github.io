---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const files = [
  { name: '01 · Service delivery map', body: 'The interview. The AI asks you one question at a time about real jobs you have done, and writes down how work actually moves through your business, stage by stage.' },
  { name: '02 · Context pack', body: 'The facts every stage assumes but nobody wrote down: what you take on and what you turn away, your standing assumptions, your shorthand, what “done” means.' },
  { name: '03 · Skill extraction', body: 'Turns one mapped task into a written skill an AI can run and a new hire can learn from, in one fixed format so skills chain together.' },
  { name: '04 · Example: quote request triage', body: 'A fictional worked example for a small fabrication shop, showing what a draft skill looks like, holes and all.' },
  { name: '05 · Verification and retro', body: 'How to test a skill against five of your own past decisions before you trust it, and the 15-minute weekly habit that makes it better.' },
  { name: '06 · Example: deal intake', body: 'A second fictional example, for a real estate investor screening new deals.' },
];

const rules = [
  ['One question at a time.', 'The AI waits for your answer. It never sends a list of questions.'],
  ['Real work, past tense.', '"Walk me through the job you finished last month" gets the truth. "What\'s your process?" gets the version nobody follows.'],
  ['Stop at every soft verb.', 'When you say "I look at it and decide," that\'s hidden judgment. The AI asks what you looked at first and what would have changed your answer.'],
  ['Numbers, word for word.', 'Prices, thresholds, lead times and limits are written down exactly as you say them.'],
  ['Ask for the exception.', 'Every rule gets a follow-up: "When do you break that?" The exceptions are where the expertise lives.'],
  ['Never invent.', 'Anything the AI inferred rather than heard is marked [UNCONFIRMED]. A visible hole beats a hidden guess.'],
  ['Record first, improve later.', 'Fixes go in a separate list, so you describe the process instead of defending it.'],
  ['45 minutes, then stop.', 'Tired answers are vague, and vague answers make bad AI skills.'],
];

const faqs = [
  ['What is the AI Foundation Kit?', 'A free set of plain-text files that turns any AI chat tool into an interviewer. It asks a business owner how work actually moves through the business, writes down the rules and numbers only the owner knows, and turns the most repetitive task into a tested AI skill.'],
  ['Who is it for?', 'Owners and operators of businesses with roughly 5 to 200 people, such as trades, shops, manufacturers, professional services firms and real estate investors, where most decisions still run through the owner.'],
  ['Which AI tools does it work with?', 'Claude, ChatGPT, Gemini, Copilot or any AI chat tool that accepts a long message. In Claude it also installs as a skill.'],
  ['What does it cost?', 'Nothing. It is licensed CC BY 4.0, so you can use, adapt and share it, including with clients, as long as you credit Timothy Gaull.'],
  ['How long does it take?', 'Two or three 45-minute interview sessions produce the first map. Most owners have a first tested skill within a few weeks.'],
  ['Why do you ask for my email?', 'To keep the download from being scraped. If you check the box, you\'ll also get the follow-up on how owners are using their first AI skill, plus occasional notes. Your email is never sold or shared, and you can unsubscribe anytime.'],
];

const kitLd = [
  {
    '@type': 'CreativeWork',
    '@id': 'https://timgaull.com/kit/#kit',
    name: 'The AI Foundation Kit',
    description: 'A free AI interview kit for business owners: map how work moves through the business, build a context pack, and turn recurring tasks into tested AI skills. Works with Claude, ChatGPT and any AI chat tool.',
    url: 'https://timgaull.com/kit/',
    author: { '@id': 'https://timgaull.com/#person' },
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    inLanguage: 'en-US',
    audience: { '@type': 'BusinessAudience', audienceType: 'Owners and operators of small and mid-sized businesses' },
    keywords: 'AI adoption, business process mapping, AI skills, Claude skill, ChatGPT prompts, small business AI, service delivery map',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];

const steps = [
  { title: 'Map', body: 'Two or three 45-minute interviews. You talk through real jobs; the AI asks and writes.' },
  { title: 'Write it down', body: 'Pull out the rules and numbers you carry in your head, once, into files everything reads.' },
  { title: 'Build a skill', body: 'Start with your most frequent task. Test it on five past cases before you trust it.' },
  { title: 'Bank corrections', body: 'Every fix becomes a dated edit, so it applies to every future run and every new hire.' },
];
---
<Base
  schema={kitLd}
  image="/og/kit.png"
  title="The AI Foundation Kit (free)"
  description="A free AI tool for business owners. It interviews you about how your business actually runs, writes down what only you know, and turns your most repetitive task into a skill AI can run. Works in Claude, ChatGPT or any AI chat tool."
>
  <div class="wrap hero">
    <p class="eyebrow">Free · by Timothy Gaull</p>
    <h1>The AI Foundation Kit</h1>
    <p class="lede">
      Get how your business actually runs out of your head and into something AI can use. You don't have to write
      it. The kit has AI interview you for it.
    </p>
    <form class="kit-form" id="kit-form" novalidate>
      <div class="field-row">
        <label>
          <span>Name <span class="muted">(optional)</span></span>
          <input type="text" name="name" autocomplete="name" maxlength="120" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required maxlength="254" />
        </label>
      </div>
      <label class="hp" aria-hidden="true">
        Leave this empty
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <label class="check">
        <input type="checkbox" name="updates" />
        <span><strong>Send me the follow-up:</strong> how owners are actually using their first AI skill, plus occasional notes on putting AI to work. Unsubscribe anytime.</span>
      </label>
      <div id="turnstile" class="turnstile"></div>
      <button class="btn" type="submit">Get the kit</button>
      <p class="small muted">Your email is used only for the kit and, if you check the box, the follow-up and occasional notes. It's never sold or shared.</p>
      <p class="form-status" id="kit-status" role="status" aria-live="polite"></p>
    </form>

    <div class="kit-done" id="kit-done" hidden>
      <h2>Your download has started.</h2>
      <p>If it didn't, <a id="kit-link" href="#">download the kit here</a>. The link works for 15 minutes.</p>
      <p>Start with the README, then open file 01 in your AI tool of choice.</p>
      <div class="tip" id="kit-tip" hidden>
        <p><strong>Did this save you time?</strong> The kit is free. If it helps, you can tip the builder whatever feels right.</p>
        <a class="btn btn-ghost" id="kit-tip-link" href="#">Leave a tip</a>
      </div>
      <p class="small muted">Want help running it? <a href={SITE.bookUrl}>{SITE.bookLabel}</a>.</p>
    </div>
    <p class="proof">Free to use and share under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
  </div>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why it works</p>
        <h2>You can't automate what isn't written down.</h2>
        <p>Most AI adoption stalls for the same reason. The tools are fine, but every chat starts cold, because the real process, the pricing rules and the judgment calls live in the owner's head. This kit builds that missing foundation first, then turns it into AI skills one at a time.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What's inside</p>
        <h2>Six plain files, plus a Claude Skill.</h2>
        <p>Everything is plain text, so it works in any AI tool today and in whatever you use in two years.</p>
      </div>
      <div class="grid grid-2">
        {files.map((f) => (
          <div class="card">
            <h3>{f.name}</h3>
            <p class="muted">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="use">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How to use it</p>
        <h2>Three ways to run it.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <p class="kind">Claude</p>
          <h3>Install it as a skill</h3>
          <p>In the Claude app's settings, find Skills and upload the zip as it is. In Claude Code, unzip it into <code>~/.claude/skills/</code>. Then say “Run the AI Foundation Kit with me.”</p>
        </div>
        <div class="card">
          <p class="kind">ChatGPT, Gemini, Copilot</p>
          <h3>Paste one file</h3>
          <p>Open file 01, paste the whole thing into a new chat, and say “Run the service delivery map interview with me. Start with session one.” Keep a real job file open in front of you.</p>
        </div>
        <div class="card featured">
          <p class="kind">With help</p>
          <h3>Run it with me</h3>
          <p>It works on its own. It goes faster with someone facilitating, because the hard part is asking the questions that surface judgment you can't see because it's yours.</p>
          <p><a href={SITE.bookUrl}>{SITE.bookLabel} →</a></p>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">A preview</p>
        <h2>The eight rules the AI interviewer follows.</h2>
        <p>These come straight from file 01. They're what make the difference between a useful map of your business and a generic chat.</p>
      </div>
      <ol class="rules">
        {rules.map(([title, body]) => (
          <li>
            <strong>{title}</strong> {body}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap narrow-left">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2>Common questions</h2>
      </div>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <div class="actions">
        <a class="btn" href="#kit-form">Get the kit</a>
      </div>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <script define:vars={{ sitekey: SITE.turnstileSiteKey }}>
    const form = document.getElementById('kit-form');
    const statusEl = document.getElementById('kit-status');
    const done = document.getElementById('kit-done');
    let widgetId = null;
    let token = '';

    function renderWidget() {
      if (!window.turnstile || widgetId !== null) return;
      widgetId = window.turnstile.render('#turnstile', {
        sitekey,
        action: 'kit_download',
        callback: (t) => { token = t; },
        'expired-callback': () => { token = ''; },
        'error-callback': () => { token = ''; },
      });
    }
    const wait = setInterval(() => { if (window.turnstile) { clearInterval(wait); renderWidget(); } }, 200);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      if (!form.email.checkValidity() || !email) {
        statusEl.textContent = 'Please enter a valid email address.';
        form.email.focus();
        return;
      }
      if (!token) {
        statusEl.textContent = 'One moment: the human check is still loading. Try again in a second.';
        return;
      }
      const button = form.querySelector('button[type=submit]');
      button.disabled = true;
      statusEl.textContent = 'Getting your download ready...';
      try {
        const res = await fetch('/api/kit/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name') || '',
            email,
            updates: data.get('updates') === 'on',
            website: data.get('website') || '',
            token,
          }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.download) {
          statusEl.textContent =
            res.status === 429 ? 'Too many tries from this connection. Please wait a bit and try again.' :
            body.error === 'invalid_email' ? 'Please enter a valid email address.' :
            'Something went wrong with the check. Please try again.';
          return;
        }
        document.getElementById('kit-link').href = body.download;
        if (body.tip) {
          document.getElementById('kit-tip-link').href = body.tip;
          document.getElementById('kit-tip').hidden = false;
        }
        form.hidden = true;
        done.hidden = false;
        done.querySelector('h2').focus?.();
        window.location.href = body.download;
      } catch {
        statusEl.textContent = 'Network error. Please try again.';
      } finally {
        button.disabled = false;
        token = '';
        if (window.turnstile && widgetId !== null) window.turnstile.reset(widgetId);
      }
    });
  </script>
</Base>
