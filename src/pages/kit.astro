---
import KitMap from '../components/kit/KitMap.astro';
import TagDecides from '../components/kit/TagDecides.astro';
import Loop from '../components/kit/Loop.astro';
import FiveSteps from '../components/kit/FiveSteps.astro';
import BeforeAfter from '../components/kit/BeforeAfter.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const files = [
  { name: '01 · Service delivery map', body: 'The interview. The AI asks you one question at a time about real jobs you have done, and writes down how work actually moves through your business, stage by stage.' },
  { name: '02 · Context pack', body: 'The facts every stage assumes but nobody wrote down: what you take on and what you turn away, your standing assumptions, your shorthand, what “done” means.' },
  { name: '03 · Skill extraction', body: 'Turns one mapped task into a written skill an AI can run and a new hire can learn from, in one fixed format so skills chain together.' },
  { name: '04 · Example: quote request triage', body: 'A fictional worked example for a small fabrication shop, showing what a draft skill looks like, holes and all.' },
  { name: '05 · Verification and retro', body: 'How to test a skill against five of your own past decisions before you trust it, and the 15-minute weekly habit that makes it better.' },
  { name: '06 · Example: deal intake', body: 'A second fictional example, for a real estate investor screening new deals.' },
];

const rules = [
  ['One question at a time.', 'The AI waits for your answer. It never sends a list of questions.'],
  ['Real work, past tense.', '"Walk me through the job you finished last month" gets the truth. "What\'s your process?" gets the version nobody follows.'],
  ['Stop at every soft verb.', 'When you say "I look at it and decide," that\'s hidden judgment. The AI asks what you looked at first and what would have changed your answer.'],
  ['Numbers, word for word.', 'Prices, thresholds, lead times and limits are written down exactly as you say them.'],
  ['Ask for the exception.', 'Every rule gets a follow-up: "When do you break that?" The exceptions are where the expertise lives.'],
  ['Never invent.', 'Anything the AI inferred rather than heard is marked [UNCONFIRMED]. A visible hole beats a hidden guess.'],
  ['Record first, improve later.', 'Fixes go in a separate list, so you describe the process instead of defending it.'],
  ['45 minutes, then stop.', 'Tired answers are vague, and vague answers make bad AI skills.'],
];

const faqs = [
  ['What is the AI Foundation Kit?', 'A free set of plain-text files that turns any AI chat tool into an interviewer. It asks a business owner how work actually moves through the business, writes down the rules and numbers only the owner knows, and turns the most repetitive task into a tested AI skill.'],
  ['Who is it for?', 'Owners and operators of businesses with roughly 5 to 200 people, such as trades, shops, manufacturers, professional services firms and real estate investors, where most decisions still run through the owner.'],
  ['How do I teach AI how my business works?', 'Write down what only you know, then give it to the AI every time. The kit does this by interviewing you: it maps how work moves through the business, collects standing facts like what you take on and turn away, pricing assumptions and approval gates, and turns one recurring task into a skill that is checked against five past decisions before you trust it.'],
  ['Which AI tools does it work with?', 'Claude, ChatGPT, Gemini, Copilot or any AI chat tool that accepts a long message. In Claude it also installs as a skill.'],
  ['What does it cost?', 'Nothing. It is licensed CC BY 4.0, so you can use, adapt and share it, including with clients, as long as you credit Timothy Gaull.'],
  ['How long does it take?', 'Two or three 45-minute interview sessions produce the first map. Most owners have a first tested skill within a few weeks.'],
  ['Why do you ask for my email?', 'To keep the download from being scraped. If you check the box, you\'ll also get the follow-up on how owners are using their first AI skill, plus occasional notes. Your email is never sold or shared, and you can unsubscribe anytime.'],
];

const kitLd = [
  {
    '@type': 'CreativeWork',
    '@id': 'https://timothygaull.com/kit/#kit',
    name: 'The AI Foundation Kit',
    description: 'A free AI interview kit for business owners: map how work moves through the business, build a context pack, and turn recurring tasks into tested AI skills. Works with Claude, ChatGPT and any AI chat tool.',
    url: 'https://timothygaull.com/kit/',
    author: { '@id': 'https://timothygaull.com/#person' },
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by/4.0/',
    inLanguage: 'en-US',
    audience: { '@type': 'BusinessAudience', audienceType: 'Owners and operators of small and mid-sized businesses' },
    keywords: 'AI adoption, business process mapping, AI skills, Claude skill, ChatGPT prompts, small business AI, service delivery map',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];

---
<Base
  schema={kitLd}
  image="/og/kit.png"
  title="Free AI Foundation Kit for business owners"
  description="Free kit that turns Claude, ChatGPT or any AI chat tool into an interviewer. It maps how your business runs and turns a repetitive task into a tested AI skill."
>
  <div class="wrap hero">
    <p class="eyebrow">Free · by Timothy Gaull</p>
    <h1>The AI Foundation Kit</h1>
    <p class="lede">
      Get how your business actually runs out of your head and into something AI can use. You don't have to write
      it. The kit has AI interview you for it.
    </p>
    <form class="kit-form" id="kit-form" novalidate>
      <div class="field-row">
        <label>
          <span>Name <span class="muted">(optional)</span></span>
          <input type="text" name="name" autocomplete="name" maxlength="120" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required maxlength="254" />
        </label>
      </div>
      <label class="hp" aria-hidden="true">
        Leave this empty
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <label class="check">
        <input type="checkbox" name="updates" />
        <span><strong>Send me the follow-up:</strong> how owners are actually using their first AI skill, plus occasional notes on putting AI to work. Unsubscribe anytime.</span>
      </label>
      <div id="cf-turnstile-box" class="turnstile"></div>
      <button class="btn" type="submit">Get the kit</button>
      <p class="small muted">Your email is used only for the kit and, if you check the box, the follow-up and occasional notes. It's never sold or shared.</p>
      <p class="form-status" id="kit-status" role="status" aria-live="polite"></p>
    </form>

    <div class="kit-done" id="kit-done" hidden>
      <h2>Your download has started.</h2>
      <p>If it didn't, <a id="kit-link" href="#">download the kit here</a>. The link works for 15 minutes.</p>
      <div class="kit-start">
        <p><strong>Using Claude?</strong> Turn on Code execution (Settings, then Capabilities). Then upload the zip as it is: Customize, then Skills, then Upload a skill. Start a chat and say “Start the AI Foundation interview.”</p>
        <p><strong>Using ChatGPT, Gemini or another AI?</strong> Copy the whole kit as one message and paste it into a new chat.</p>
        <div class="actions">
          <button type="button" class="btn btn-ghost" id="kit-copy" disabled>Copy the starter prompt</button>
          <a class="small" id="kit-prompt-file" href="#">or download it as one file</a>
        </div>
        <p class="form-status" id="kit-copy-status" role="status" aria-live="polite"></p>
      </div>
      <div class="tip" id="kit-tip" hidden>
        <p><strong>Did this save you time?</strong> The kit is free. If it helps, you can tip whatever feels right.</p>
        <div id="tip-choose">
          <div class="tip-amounts" role="radiogroup" aria-label="Tip amount">
            <button type="button" class="tip-amount" data-cents="500" role="radio" aria-checked="false">$5</button>
            <button type="button" class="tip-amount" data-cents="1500" role="radio" aria-checked="true">$15</button>
            <button type="button" class="tip-amount" data-cents="3000" role="radio" aria-checked="false">$30</button>
            <label class="tip-custom">
              <span class="visually-hidden">Other amount in dollars</span>
              <span aria-hidden="true">$</span>
              <input type="number" id="tip-other" min="3" max="500" step="1" inputmode="numeric" placeholder="Other" />
            </label>
          </div>
          <button type="button" class="btn" id="tip-continue">Tip $15</button>
        </div>
        <form id="tip-pay" hidden novalidate>
          <div id="express-checkout-element"></div>
          <p class="tip-or" id="tip-or" hidden><span>Or pay another way</span></p>
          <div id="payment-element"></div>
          <button type="submit" class="btn" id="tip-submit" disabled>Pay</button>
          <button type="button" class="linklike" id="tip-back">Change amount</button>
        </form>
        <p class="form-status" id="tip-status" role="status" aria-live="polite"></p>
        <p class="tip-thanks" id="tip-thanks" hidden><strong>Thank you.</strong> Tips like yours keep the kit free for the next owner.</p>
      </div>
      <p class="small muted">Want help running it? <a href={SITE.workUrl}>{SITE.workLabel}</a>.</p>
    </div>
    <p class="proof">Free to use and share under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
  </div>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>How work moves through any business</h2>
        <p>Every business has a version of this. The kit maps yours by interviewing you about one real, finished job, then tags each stage by the kind of work it takes. Pick your business to see it in your terms.</p>
      </div>
      <KitMap />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What changes</p>
        <h2>What happens to each stage</h2>
        <p>The tag on each stage decides its future. Routine stages become skills your AI runs. The calls only you can make stay with you.</p>
      </div>
      <TagDecides />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why it compounds</p>
        <h2>Good work feeds the next job</h2>
        <p>Each stage hands its output to the next, and the last one asks for the review that brings in the next request.</p>
      </div>
      <Loop />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why it works</p>
        <h2>You can't automate what isn't written down.</h2>
        <p>Most AI adoption stalls for the same reason. The tools are fine, but every chat starts cold, because the real process, the pricing rules and the judgment calls live in the owner's head. This kit builds that missing foundation first, then turns it into AI skills one at a time.</p>
      </div>
      <FiveSteps />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">In practice</p>
        <h2>The bottleneck is rarely the people</h2>
        <p>Three real projects. Each fix moved routine work into a simple tool the team already uses, and gave their time back to the work that needs them.</p>
      </div>
      <BeforeAfter />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What's inside</p>
        <h2>Six plain files, plus a Claude Skill.</h2>
        <p>Everything is plain text, so it works in any AI tool today and in whatever you use in two years.</p>
      </div>
      <div class="grid grid-2">
        {files.map((f) => (
          <div class="card">
            <h3>{f.name}</h3>
            <p class="muted">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="use">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How to use it</p>
        <h2>Three ways to run it.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <p class="kind">Claude</p>
          <h3>Install it as a skill</h3>
          <p>In the Claude app's settings, find Skills and upload the zip as it is. In Claude Code, unzip it into <code>~/.claude/skills/</code>. Then say “Run the AI Foundation Kit with me.”</p>
        </div>
        <div class="card">
          <p class="kind">ChatGPT, Gemini, Copilot</p>
          <h3>Paste one file</h3>
          <p>Open file 01, paste the whole thing into a new chat, and say “Run the service delivery map interview with me. Start with session one.” Keep a real job file open in front of you.</p>
        </div>
        <div class="card featured">
          <p class="kind">With help</p>
          <h3>Run it with me</h3>
          <p>It works on its own. It goes faster with someone facilitating, because the hard part is asking the questions that surface judgment you can't see because it's yours.</p>
          <p><a href={SITE.workUrl}>{SITE.workLabel} →</a></p>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">A preview</p>
        <h2>The eight rules the AI interviewer follows.</h2>
        <p>These come straight from file 01. They're what make the difference between a useful map of your business and a generic chat.</p>
      </div>
      <ol class="rules">
        {rules.map(([title, body]) => (
          <li>
            <strong>{title}</strong> {body}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap narrow-left">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2>Common questions</h2>
      </div>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
      <div class="actions">
        <a class="btn" href="#kit-form">Get the kit</a>
      </div>
    </div>
  </section>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <script define:vars={{ sitekey: SITE.turnstileSiteKey }}>
    const form = document.getElementById('kit-form');
    const statusEl = document.getElementById('kit-status');
    const done = document.getElementById('kit-done');
    let widgetId = null;
    let token = '';

    function renderWidget() {
      if (typeof window.turnstile?.render !== 'function' || widgetId !== null) return;
      widgetId = window.turnstile.render('#cf-turnstile-box', {
        sitekey,
        action: 'kit_download',
        callback: (t) => { token = t; },
        'expired-callback': () => { token = ''; },
        'error-callback': () => { token = ''; },
      });
    }
    const wait = setInterval(() => { if (typeof window.turnstile?.render === 'function') { clearInterval(wait); renderWidget(); } }, 200);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const email = String(data.get('email') || '').trim();
      if (!form.email.checkValidity() || !email) {
        statusEl.textContent = 'Please enter a valid email address.';
        form.email.focus();
        return;
      }
      if (!token) {
        statusEl.textContent = 'One moment: the human check is still loading. Try again in a second.';
        return;
      }
      const button = form.querySelector('button[type=submit]');
      button.disabled = true;
      statusEl.textContent = 'Getting your download ready...';
      try {
        const res = await fetch('/api/kit/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name') || '',
            email,
            updates: data.get('updates') === 'on',
            website: data.get('website') || '',
            token,
          }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.download) {
          statusEl.textContent =
            res.status === 429 ? 'Too many tries from this connection. Please wait a bit and try again.' :
            body.error === 'invalid_email' ? 'Please enter a valid email address.' :
            'Something went wrong with the check. Please try again.';
          return;
        }
        document.getElementById('kit-link').href = body.download;
        // The starter prompt sits behind the same signed link. Fetch it now so the copy button works in one click.
        const promptUrl = body.download.replace('/api/kit/download', '/api/kit/prompt');
        document.getElementById('kit-prompt-file').href = promptUrl + '&file=1';
        fetch(promptUrl).then((r) => (r.ok ? r.text() : Promise.reject())).then((text) => {
          const copyBtn = document.getElementById('kit-copy');
          const copyStatus = document.getElementById('kit-copy-status');
          copyBtn.disabled = false;
          copyBtn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(text);
            } catch {
              const area = Object.assign(document.createElement('textarea'), { value: text });
              document.body.append(area);
              area.select();
              document.execCommand('copy');
              area.remove();
            }
            copyBtn.textContent = 'Copied';
            copyStatus.textContent = 'Copied. Open a new chat in your AI tool, paste, and press Enter.';
          });
        }).catch(() => {
          document.getElementById('kit-copy-status').textContent = 'The starter prompt didn’t load. Use the “download it as one file” link instead.';
        });
        if (body.tip) {
          document.getElementById('kit-tip').hidden = false;
          window.dispatchEvent(new CustomEvent('kit:tip', { detail: { ...body.tip, email } }));
        }
        form.hidden = true;
        done.hidden = false;
        done.querySelector('h2').focus?.();
        window.location.href = body.download;
      } catch {
        statusEl.textContent = 'Network error. Please try again.';
      } finally {
        button.disabled = false;
        token = '';
        if (window.turnstile && widgetId !== null) window.turnstile.reset(widgetId);
      }
    });
  </script>

  <script is:inline>
    // Embedded tip: Stripe Checkout Sessions (ui_mode elements) with the Payment Element.
    // Stripe.js loads only when someone chooses to tip, straight from js.stripe.com.
    (() => {
      let ctx = null;
      let cents = 1500;
      let actions = null;
      const $ = (id) => document.getElementById(id);
      const statusEl = $('tip-status');
      const money = (c) => '$' + (c / 100).toFixed(c % 100 ? 2 : 0);

      function select(c, fromButton) {
        cents = c;
        document.querySelectorAll('.tip-amount').forEach((b) => b.setAttribute('aria-checked', String(Number(b.dataset.cents) === c && fromButton)));
        $('tip-continue').textContent = 'Tip ' + money(c);
      }
      document.querySelectorAll('.tip-amount').forEach((b) =>
        b.addEventListener('click', () => { $('tip-other').value = ''; select(Number(b.dataset.cents), true); }));
      $('tip-other').addEventListener('input', (e) => {
        const d = Math.round(Number(e.target.value));
        if (d >= 3 && d <= 500) select(d * 100, false);
      });

      function loadStripe() {
        if (window.Stripe) return Promise.resolve();
        return new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = 'https://js.stripe.com/dahlia/stripe.js';
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }

      window.addEventListener('kit:tip', (e) => { ctx = e.detail; });

      $('tip-continue').addEventListener('click', async () => {
        if (!ctx) return;
        const btn = $('tip-continue');
        btn.disabled = true;
        statusEl.textContent = 'Loading secure payment form...';
        try {
          await loadStripe();
          const clientSecret = fetch('/api/tip/session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount: cents, exp: ctx.exp, sig: ctx.sig, email: ctx.email }),
          }).then(async (r) => {
            const b = await r.json().catch(() => ({}));
            if (!r.ok || !b.clientSecret) throw new Error(b.error || 'stripe_error');
            return b.clientSecret;
          });
          clientSecret.catch(() => {}); // the failure surfaces through loadActions below
          const stripe = window.Stripe(ctx.publishableKey);
          const checkout = stripe.initCheckoutElementsSdk({
            clientSecret,
            elementsOptions: {
              appearance: {
                theme: 'stripe',
                variables: {
                  colorPrimary: '#141414',
                  colorText: '#141414',
                  colorBackground: '#ffffff',
                  fontFamily: '"IBM Plex Sans", "Helvetica Neue", Arial, sans-serif',
                  borderRadius: '8px',
                },
              },
              fonts: [{ cssSrc: 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap' }],
            },
          });
          checkout.on('change', (session) => { $('tip-submit').disabled = !session.canConfirm; });
          // One-tap wallets (Apple Pay, Google Pay, Link) above the card form. They only
          // appear on HTTPS domains registered with Stripe, so none show on localhost.
          const express = checkout.createExpressCheckoutElement({
            buttonTheme: { applePay: 'black', googlePay: 'black' },
            buttonHeight: 48,
          });
          express.on('ready', ({ availablePaymentMethods }) => {
            $('tip-or').hidden = !availablePaymentMethods || !Object.values(availablePaymentMethods).some(Boolean);
          });
          express.on('confirm', async (event) => {
            if (!actions) return;
            statusEl.textContent = 'Processing...';
            const result = await actions.confirm({ expressCheckoutConfirmEvent: event, redirect: 'if_required' });
            if (result.type === 'error') { statusEl.textContent = result.error.message; return; }
            showThanks();
          });
          express.mount('#express-checkout-element');
          checkout.createPaymentElement({ layout: { type: 'accordion', defaultCollapsed: false } }).mount('#payment-element');
          const loaded = await checkout.loadActions();
          if (loaded.type !== 'success') throw new Error('load_failed');
          actions = loaded.actions;
          $('tip-submit').textContent = 'Pay ' + money(cents);
          $('tip-choose').hidden = true;
          $('tip-pay').hidden = false;
          statusEl.textContent = '';
        } catch (err) {
          // Start clean so a failed load never leaves an empty payment form on screen.
          $('payment-element').replaceChildren();
          $('express-checkout-element').replaceChildren();
          $('tip-pay').hidden = true;
          $('tip-choose').hidden = false;
          actions = null;
          statusEl.textContent = String(err.message) === 'expired'
            ? 'This page has been open a while. Refresh and download again to tip.'
            : 'The payment form could not load. Please try again in a moment.';
        } finally {
          btn.disabled = false;
        }
      });

      $('tip-back').addEventListener('click', () => {
        // A new amount needs a new Checkout Session, so start the form over.
        $('payment-element').replaceChildren();
        $('express-checkout-element').replaceChildren();
        $('tip-or').hidden = true;
        actions = null;
        $('tip-pay').hidden = true;
        $('tip-choose').hidden = false;
      });

      $('tip-pay').addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!actions) return;
        const btn = $('tip-submit');
        btn.disabled = true;
        statusEl.textContent = 'Processing...';
        const result = await actions.confirm({ redirect: 'if_required' });
        if (result.type === 'error') {
          statusEl.textContent = result.error.message;
          btn.disabled = false;
          return;
        }
        // Payments that need a redirect (some wallets, 3D Secure) return via /kit/thanks/.
        showThanks();
      });

      function showThanks() {
        $('tip-pay').hidden = true;
        statusEl.textContent = '';
        $('tip-thanks').hidden = false;
      }
    })();
  </script>
</Base>
