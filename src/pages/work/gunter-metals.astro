---
// Search targets (docs/seo-strategy.md): I2 AI and online sales for metal fabrication; B1 brand identity with AI; B3 branding for a fabrication shop.
import CaseFeature from '../../layouts/CaseFeature.astro';
import '../../styles/gunter.css';

const before = ['A one-page website', 'A simple contact form', 'No way to buy metal online', 'Service requests with little to go on'];

const after = [
  'A digital metal counter with dynamic pricing',
  'Real products and inventory, kept up to date from a spreadsheet',
  'Metal ordered to length from a phone, ready the same day when it is on the rack',
  "Requests for proposals that go straight into Jobber, the shop's CRM and quoting tool",
];

const flow = [
  ['Tim and Etta keep a spreadsheet', "What's for sale, what it costs and what's on the rack live in one spreadsheet they already know how to edit. Change a row and the prices and stock on the site follow."],
  ['Every size is a real product', 'Steel, stainless and aluminum in tube, angle, channel, flat bar, plate and more, each with its own price and inventory, so customers see whether it is on the rack or has to be ordered in.'],
  ['Customers type a cut list', '“4 @ 36” and “2 @ 8 ft” turn into pieces and total length as they type, the way a good counter clerk would add it up.'],
  ['They pick it up the same day', 'Stock on the rack is ready the same day. Anything else gets a call with a pickup date.'],
];

const phones = [
  ['zoom-start', 'Metal, cut to length', 'The top of the Gunter Metals buying page on a phone: “Metal, cut to length. Ready today.” over a jobsite photo.'],
  ['zoom-shapes', 'Pick a shape', 'The shape picker: square tube, rect tube, angle, channel, flat bar, plate, round tube, round bar and remnants, above the metal, shape, size and cut list steps.'],
  ['zoom-cutlist', 'Type the cut list', 'A cut list typed as “4 @ 36” and “2 @ 8 ft”, totaling 6 pieces and 28 feet, with the stock status and an Add to cut list button.'],
];

const steps = [
  ['Research', 'A competitive map of regional shops and a mood board built from real steel: mill scale, galvanizing, powder coat.'],
  ['Surface study', 'How bare, galvanized and powder-coated steel actually read on screen, so the brand colors come from the material instead of a trend.'],
  ['Letterforms', 'Monogram and stencil studies, then a wordmark drawn to be manufactured. The bridges in the letters are sized to what a torch and the sheet can hold.'],
  ['Iteration', 'Many rounds across Claude, Illustrator and Figma. AI widened the options and pressure-tested them. I made the calls.'],
];

// From the ShapeExploration page of the Gunter Metals Figma file.
const studies = [
  ['study-up.webp', 1342, 945, 'Scroll top · looking up', 'The 3D wordmark seen from slightly below, its extruded edges showing above the letters.'],
  ['study-straight.webp', 1342, 945, 'Mid-scroll · straight on', 'The 3D wordmark seen straight on.'],
  ['study-down.webp', 1342, 945, 'Scroll bottom · looking down', 'The 3D wordmark seen from slightly above, its extruded edges showing below the letters.'],
  ['bridge-study.svg', 136, 136, 'Bridge study · G monogram', 'A round G monogram with a stencil bridge.'],
];

const finishes = [
  ['mill-steel', 'Mill steel'],
  ['galvanized', 'Galvanized'],
  ['powder-black', 'Powder black'],
];
---
<CaseFeature
  title="Gunter Metals: from a contact form to a digital metal counter"
  description="Gunter Metals is a metal fabrication shop in Middle Tennessee. It had a one-page website with a contact form. Now customers buy metal cut to length from their phones and see what is in stock, and requests for proposals go straight into Jobber, the shop's CRM and quoting tool. I designed the brand and built the storefront."
  seoTitle="Gunter Metals: a digital metal counter"
  metaDescription="Gunter Metals went from a one-page site and a contact form to a phone-first metal counter with live stock, and requests that flow into its CRM and quoting tool."
  eyebrow="Gunter Metals"
  image={{ src: '/images/work/gunter-wordmark-hero.jpg', width: 1600, height: 911 }}
  published="2026-09-26"
  updated="2026-10-06"
  client={{ name: 'Gunter Metals', url: 'https://guntermetals.com/' }}
  facts={[
    { label: 'Role', value: 'Brand, storefront and systems' },
    { label: 'Phase one', value: 'Live at guntermetals.com' },
    { label: 'Built on', value: 'Shopify, with Jobber for CRM and quoting' },
    { label: 'Brand identity', value: '4 days, designed with Claude' },
  ]}
  theme={{
    '--cs-accent': '#e0552c',
    '--cs-hero-bg': 'radial-gradient(85% 70% at 16% 6%, rgba(214,226,238,.16), transparent 62%), radial-gradient(140% 120% at 50% 40%, transparent 50%, rgba(0,0,0,.5)), repeating-linear-gradient(179deg, rgba(255,255,255,.02) 0 1px, transparent 1px 5px), linear-gradient(158deg, #383e45 0%, #2a2f35 45%, #202428 100%)',
    '--cs-hero-ink': '#f1f3f4',
    '--cs-hero-muted': '#a8b0b7',
    '--cs-hero-line': 'rgba(255,255,255,.12)',
    '--cs-hero-chip': 'rgba(16,18,21,.55)',
    '--cs-dark': '#16191c',
    '--cs-stock': '#e4e1da',
  }}
  next={{ href: '/work/alliancebernstein/', title: 'Taking 6,000 people off paper at a global asset manager' }}
>
  <!-- Signature moment: the storefront's own torch cut, driven by scroll. -->
  <section slot="signature" id="gm-cut" class="gm-cut">
    <div class="gm-cut__pin">
      <gm-cutsheet reveal="scroll" track="#gm-cut" edge="soft" label="Gunter Metals LLC">
        <noscript><img src="/images/work/gunter-wordmark-hero.jpg" alt="The Gunter Metals LLC wordmark, cut from steel." width="1600" height="911" /></noscript>
      </gm-cutsheet>
      <p class="gm-cut__caption">
        <span class="gm-cut__cutting">The wordmark, cut from a sheet of steel as you scroll</span>
        <span class="gm-cut__done">The gaps in the R and the A are stencil bridges, sized so a torch can cut the letters from the sheet</span>
      </p>
    </div>
  </section>

  <section class="cs-band cs-band--fade">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>Before</p>
      <p class="cs-statement" data-words>Gunter Metals had a one-page website with a contact form.</p>
      <div class="cs-after">
        <p data-reveal>There was no way to buy metal online, and service requests came in with little to go on. Orders, quotes and questions all ran through Tim and Etta's phones.</p>
        <p data-reveal style="--i: 1">The shop needed a digital metal counter: somewhere customers could find the metal they need, see the price and whether it is in stock, and order it cut to length without a phone call.</p>
      </div>
    </div>
  </section>

  <section class="cs-band" style="padding-top: 0">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>Phase one</p>
      <h2 class="cs-h2" data-reveal>What the shop can do now</h2>
      <div class="cs-compare">
        <figure class="cs-browser" data-reveal>
          <div>
            <p class="cs-browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>guntermetals.com, 2025</span></p>
            <img src="/images/work/gunter/before-home.jpg" alt="The old Gunter Metals website: a single page with the logo, a stock photo of a welder, the line “Metals. Fabrication. Welding. Done.” and a Contact Us button." width="1440" height="900" loading="lazy" />
          </div>
          <figcaption>Before · one page and a contact form</figcaption>
        </figure>
        <figure class="cs-browser" data-reveal style="--i: 1">
          <div>
            <p class="cs-browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>guntermetals.com/collections/all</span></p>
            <img src="/images/work/gunter/after-counter.jpg" alt="The new Gunter Metals metal counter: “Metal, cut to length. Ready today.” over a jobsite photo, shop hours with a same-day cutoff, and steel, stainless and aluminum to choose from." width="1440" height="900" loading="lazy" />
          </div>
          <figcaption>After · the digital metal counter</figcaption>
        </figure>
      </div>
      <div class="cs-split" data-reveal>
        <div>
          <h3>Before</h3>
          <ul>
            {before.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h3>After phase one</h3>
          <ul>
            {after.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <p class="cs-pull" data-reveal>Phase one came in <em>well above expectations</em>. The metal counter works, and Tim and Etta can run it themselves.</p>
    </div>
  </section>

  <section class="cs-band cs-band--dark">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>The metal counter</p>
      <h2 class="cs-h2" data-reveal>A digital metal counter, built for phones</h2>
      <p class="cs-intro" data-reveal>Live at <a href="https://guntermetals.com/">guntermetals.com</a>. Customers pick the metal, shape and size, see whether it is on the rack, and type a cut list the way they would say it at the counter.</p>
      <div class="cs-flow">
        <ol class="cs-flow__steps">
          {flow.map(([title, body], i) => (
            <li data-reveal style={`--i: ${i}`}>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))}
        </ol>
        <div class="cs-phones">
          {phones.map(([file, caption, alt], i) => (
            <figure class="cs-phone" data-reveal style={`--i: ${i}`}>
              <div><img src={`/images/work/gunter/${file}.jpg`} alt={alt} width="1170" height="1680" loading="lazy" /></div>
              <figcaption>{caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="cs-also">
        <div data-reveal>
          <h3>Requests for proposals go into Jobber</h3>
          <p>Service and commercial requests flow straight into Jobber, the shop's CRM and quoting tool, so every request arrives in one place and nothing lives only in a text message.</p>
        </div>
        <div data-reveal style="--i: 1">
          <h3>A catalog AI can read</h3>
          <p>Product and pricing rules sit in plain, tested files, so the same logic serves the website, AI shopping assistants and future tools for contractors.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-band">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>The brand</p>
      <h2 class="cs-h2" data-reveal>Four days, with Claude as a design partner</h2>
      <p class="cs-intro" data-reveal>The shop also needed a brand that looks like the work it does. The brand identity was designed with AI in four days and a lot of iteration. I used Claude through every step I would normally run with a studio team.</p>
      <ol class="cs-steps">
        {steps.map(([title, body], i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="cs-steps__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
      <div class="cs-studies">
        <p class="cs-label" data-reveal>Motion studies, from the Figma file</p>
        <div class="cs-plates cs-plates--4">
          {studies.map(([file, w, h, name, alt], i) => (
            <figure class="cs-plate" data-reveal style={`--i: ${i}`}>
              <div><img src={`/images/work/gunter/${file}`} alt={alt} width={w} height={h} loading="lazy" /></div>
              <figcaption>{name}</figcaption>
            </figure>
          ))}
        </div>
        <p class="cs-note" data-reveal>Early studies for how the wordmark tilts as the page scrolls, drawn before the stencil bridges were added.</p>
      </div>
      <p class="cs-pull" data-reveal>AI didn't design the brand. It let one person do <em>a studio's worth of exploring</em> in four days, and spend the saved time on the decisions that matter.</p>
    </div>
  </section>

  <section class="cs-band cs-band--stock">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>The finishes</p>
      <h2 class="cs-h2" data-reveal>Colors from the material, not a trend</h2>
      <div class="cs-plates">
        {finishes.map(([file, name], i) => (
          <figure class="cs-plate" data-reveal style={`--i: ${i}; --cs-plate-bg: #f4f2ee`}>
            <div><gm-wordmark finish={file} scroll="cover" label={`Gunter Metals LLC wordmark, ${name.toLowerCase()} finish`}><img src={`/images/work/gunter-wordmark-${file}.svg`} alt={`The wordmark in a ${name.toLowerCase()} finish`} width="448" height="315" loading="lazy" /></gm-wordmark></div>
            <figcaption>{name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="cs-band">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>Who did what</p>
      <h2 class="cs-h2" data-reveal>AI widened the options. I made the calls.</h2>
      <div class="cs-split" data-reveal>
        <div>
          <h3>What AI did</h3>
          <ul>
            <li>Mapped regional competitors and built mood boards from real steel</li>
            <li>Studied how bare, galvanized and powder-coated steel read on screen</li>
            <li>Generated monogram and stencil studies, round after round</li>
            <li>Pressure-tested every direction</li>
          </ul>
        </div>
        <div>
          <h3>What I decided</h3>
          <ul>
            <li>A stencil wordmark, with bridges sized to what a torch and the sheet can hold</li>
            <li>Brand colors taken from the material</li>
            <li>An ordering flow in shop language: metal, shape, size, cut list</li>
            <li>Writing the business rules down before AI touched pricing</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-band cs-band--dark">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>What's next</p>
      <h2 class="cs-h2" data-reveal>Phase two: sharper quotes and more metal sales</h2>
      <div class="cs-also">
        <div data-reveal>
          <h3>Quote requests that capture the job</h3>
          <p>More automation in the request flow, so customers can describe the work precisely and the shop gets what it needs to quote.</p>
        </div>
        <div data-reveal style="--i: 1">
          <h3>Campaigns for metal sales</h3>
          <p>Campaigns that bring buyers to the metal counter, so metal sales grow alongside fabrication work and the business has more than one source of income.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cs-band cs-band--stock">
    <div class="cs-wide">
      <p class="cs-label" data-reveal>Why it matters for your business</p>
      <p class="cs-statement cs-statement--wide" data-words>The AI part only works because the business rules were written down first.</p>
      <div class="cs-after">
        <p data-reveal>What the shop sells, what it costs, how a cut list gets checked and how a request reaches the shop all became files and systems every tool reads from.</p>
        <p data-reveal style="--i: 1">That's the same foundation the <a href="/kit/">free AI Foundation Kit</a> helps you build.</p>
      </div>
    </div>
  </section>
</CaseFeature>

<script>
  // <gm-wordmark> and <gm-cutsheet>, from the Gunter Metals storefront theme.
  import '../../vendor/gm-cutsheet.js';
</script>
