---
// Feature case study: an immersive layout each story themes for itself (palette, hero ground, accent),
// set inside the site's own header and footer. Sections come from src/components/case/.
import Base from './Base.astro';
import '../styles/case.css';
import { SITE } from '../site';
import { caseStudySchema, type CaseStudyProps } from '../lib/case-study';

interface Props extends CaseStudyProps {
  // CSS custom properties for this story, e.g. { '--cs-accent': '#e0552c', '--cs-hero-bg': '…' }.
  theme?: Record<string, string>;
  next?: { href: string; title: string };
}

const { title, description, eyebrow, facts, seoTitle, metaDescription, image, theme = {}, next } = Astro.props;
// "Client: what was done" sets the client name large and the claim beneath it.
const split = title.indexOf(': ');
const name = split > 0 ? title.slice(0, split) : title;
const claim = split > 0 ? title.slice(split + 2) : '';
const style = Object.entries(theme).map(([k, v]) => `${k}:${v}`).join(';');
---
<Base
  title={seoTitle ?? title}
  description={metaDescription ?? description}
  image={image?.src}
  imageWidth={image?.width}
  imageHeight={image?.height}
  schema={caseStudySchema(Astro.props, Astro.url.pathname, Astro.site!)}
>
  <article class="cs" style={style}>
    <header class="cs-hero">
      <div class="cs-wide cs-hero__inner">
        <p class="cs-label cs-hero__crumb"><a href="/work/">Work</a><span aria-hidden="true">/</span><span>{eyebrow}</span></p>
        <h1 class="cs-hero__title">
          <span class="cs-hero__name">{name}</span>{claim && <span class="visually-hidden">: </span>}
          {claim && <span class="cs-hero__claim">{claim}</span>}
        </h1>
        <div class="cs-hero__foot">
          <p class="cs-hero__lede">{description}</p>
          <dl class="cs-facts">
            {facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        <p class="cs-hero__cue" aria-hidden="true">Scroll <i></i></p>
      </div>
    </header>

    <slot name="signature" />
    <slot />

    <section class="cs-band cs-cta">
      <div class="cs-wide">
        <p class="cs-label" data-reveal>Next step</p>
        <h2 class="cs-cta__title" data-reveal>Working on something similar?</h2>
        <div class="actions" data-reveal>
          <a class="btn" href={SITE.workUrl}>{SITE.workLabel}</a>
          <a class="btn btn-ghost" href="/kit/">Start with the free AI Foundation Kit</a>
        </div>
      </div>
    </section>

    {next && (
      <a class="cs-next" href={next.href}>
        <span class="cs-wide cs-next__inner">
          <span class="cs-label">Next case study</span>
          <span class="cs-next__title">{next.title}<span class="cs-next__arrow" aria-hidden="true">→</span></span>
        </span>
      </a>
    )}
  </article>
</Base>

<script>
  // Restrained motion: sections fade up once, statements light word by word with the scroll.
  // Nothing moves when the visitor prefers reduced motion.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    document.documentElement.classList.add('cs-motion');

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    const statements = [...document.querySelectorAll<HTMLElement>('[data-words]')].map((el) => {
      // Screen readers get the sentence whole; the per-word spans are visual only.
      const text = el.textContent!.trim();
      const said = Object.assign(document.createElement('span'), { className: 'visually-hidden', textContent: text });
      const shown = document.createElement('span');
      shown.setAttribute('aria-hidden', 'true');
      shown.append(
        ...text.split(/\s+/).flatMap((word, i) => {
          const w = Object.assign(document.createElement('span'), { className: 'w', textContent: word });
          return i ? [' ', w] : [w];
        }),
      );
      el.replaceChildren(said, shown);
      return { el, words: [...shown.querySelectorAll<HTMLElement>('.w')], lit: -1 };
    });
    let queued = false;
    const paint = () => {
      queued = false;
      const vh = innerHeight;
      for (const s of statements) {
        const r = s.el.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh * 0.88 - r.top) / (r.height + vh * 0.38)));
        const lit = Math.round(p * s.words.length);
        if (lit === s.lit) continue;
        s.words.forEach((w, i) => w.classList.toggle('on', i < lit));
        s.lit = lit;
      }
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(paint);
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    paint();
  }
</script>
