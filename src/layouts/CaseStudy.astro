---
import Base from './Base.astro';
import { SITE } from '../site';
import { caseStudySchema, type CaseStudyProps } from '../lib/case-study';

type Props = CaseStudyProps;

const { title, description, eyebrow, facts, seoTitle, metaDescription, image } = Astro.props;
---
<Base
  title={seoTitle ?? title}
  description={metaDescription ?? description}
  image={image?.src}
  imageWidth={image?.width}
  imageHeight={image?.height}
  schema={caseStudySchema(Astro.props, Astro.url.pathname, Astro.site!)}
>
  <div class="narrow article-head">
    <p class="eyebrow"><a href="/work/">Work</a> · {eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
  <article class="narrow prose">
    <slot />
    <div class="note">
      <p><strong>Working on something similar?</strong> <a href={SITE.workUrl}>See how we’d work together</a>, or start with the <a href="/kit/">free AI Foundation Kit</a>.</p>
    </div>
  </article>
</Base>
