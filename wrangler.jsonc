{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timothygaull-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The site is static Astro output. The Worker runs first on every request so it can
  // redirect the other domains to timothygaull.com before serving pages.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // The kit zip is bundled into the Worker, never published as a static file.
  "rules": [{ "type": "Data", "globs": ["**/*.zip"], "fallthrough": false }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timothygaull-kit",
      "database_id": "1e73d46b-f128-4890-b677-e5f62e9138fc",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Frontend hostnames allowed to submit the kit form (checked against siteverify).
    "TURNSTILE_HOSTNAMES": "timothygaull.com,www.timothygaull.com",
    // Stripe Payment Link for tips. Empty hides the tip on the thank-you screen.
    "TIP_URL": ""
  },
  "observability": { "enabled": true },
  // Secrets, set in the Cloudflare dashboard (never in this file):
  //   TURNSTILE_SECRET, DOWNLOAD_SIGNING_KEY
  // timothygaull.com is canonical. Every other host below is attached so it gets a
  // certificate, and the Worker 301-redirects it to timothygaull.com.
  "routes": [
    { "pattern": "timothygaull.com", "custom_domain": true },
    { "pattern": "www.timothygaull.com", "custom_domain": true },
    { "pattern": "timgaull.com", "custom_domain": true },
    { "pattern": "www.timgaull.com", "custom_domain": true },
    { "pattern": "timothygaul.com", "custom_domain": true },
    { "pattern": "www.timothygaul.com", "custom_domain": true },
    { "pattern": "timothygual.com", "custom_domain": true },
    { "pattern": "www.timothygual.com", "custom_domain": true },
    { "pattern": "timgual.com", "custom_domain": true },
    { "pattern": "www.timgual.com", "custom_domain": true }
  ]
}
