{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timothygaull-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The site is static Astro output. The Worker runs first on every request so it can
  // redirect the other domains to timothygaull.com before serving pages.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // The kit zip and its one-message starter prompt are bundled into the Worker, never published as static files.
  "rules": [
    { "type": "Data", "globs": ["**/*.zip"], "fallthrough": false },
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": false }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timothygaull-kit",
      "database_id": "1e73d46b-f128-4890-b677-e5f62e9138fc",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Frontend hostnames allowed to submit the kit form (checked against siteverify).
    "TURNSTILE_HOSTNAMES": "timothygaull.com,www.timothygaull.com",
    // Embedded tips (Stripe Checkout Sessions + Payment Element). Tips stay hidden until the
    // publishable key, the tip product and the STRIPE_SECRET_KEY secret are all set for live mode.
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51UKBXeRfJENryS20edheUWKrzsgaL4Jjf8dgKeSFn8WZIpnHjzh3100qpJ8n7igl8vHYAhIrHTyJJr6gAm1cH46Z00mQOPGyXN",
    "STRIPE_TIP_PRODUCT": "prod_VLT9BQt5nWFVk7",
    // Private /admin/ dashboard: Cloudflare Access app "Admin" on timothygaull.com/admin. Not secrets;
    // the Worker checks Access's signed token against these. ADMIN_EMAILS is a dashboard secret.
    "ACCESS_TEAM_DOMAIN": "timothygaull.cloudflareaccess.com",
    "ACCESS_AUD": "5de6280c7fbdb5db0ed19e7ace4ee9ebd69aa309b611d1cdc074c3dfbe0598c9",
    // Form alerts via Postmark (worker alert()); they stay off until the POSTMARK_TOKEN secret is set in the dashboard.
    "ALERT_FROM": "Gaull & Co <alerts@gaullco.com>",
    "ALERT_TO": "tim@gaullco.com"
  },
  "observability": { "enabled": true },
  // Secrets, set in the Cloudflare dashboard (never in this file):
  //   TURNSTILE_SECRET, DOWNLOAD_SIGNING_KEY, STRIPE_SECRET_KEY (restricted key: Checkout Sessions write),
  //   ADMIN_EMAILS (comma-separated; kept out of this public repo), PostmarkGaullCo (Postmark server API token; POSTMARK_TOKEN also accepted)
  // timothygaull.com is canonical (timgaul.com, one L, belongs to someone else). Every other
  // host below is attached so it gets a certificate, and the Worker 301-redirects it here.
  "routes": [
    { "pattern": "timothygaull.com", "custom_domain": true },
    { "pattern": "www.timothygaull.com", "custom_domain": true },
    { "pattern": "timgaull.com", "custom_domain": true },
    { "pattern": "www.timgaull.com", "custom_domain": true },
    { "pattern": "timothygaul.com", "custom_domain": true },
    { "pattern": "www.timothygaul.com", "custom_domain": true },
    { "pattern": "timothygual.com", "custom_domain": true },
    { "pattern": "www.timothygual.com", "custom_domain": true },
    { "pattern": "timgual.com", "custom_domain": true },
    { "pattern": "www.timgual.com", "custom_domain": true },
    // gaullco.com: the practice name (Gaull & Co, the Google Business Profile), redirected here.
    { "pattern": "gaullco.com", "custom_domain": true },
    { "pattern": "www.gaullco.com", "custom_domain": true }
  ]
}
