{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timothygaull-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // The site is static Astro output. The Worker only runs for /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // The kit zip is bundled into the Worker, never published as a static file.
  "rules": [{ "type": "Data", "globs": ["**/*.zip"], "fallthrough": false }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timothygaull-kit",
      "database_id": "1e73d46b-f128-4890-b677-e5f62e9138fc",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Frontend hostnames allowed to submit the kit form (checked against siteverify).
    "TURNSTILE_HOSTNAMES": "timothygaull.com,www.timothygaull.com",
    // Stripe Payment Link for tips. Empty hides the tip on the thank-you screen.
    "TIP_URL": ""
  },
  "observability": { "enabled": true }
  // Secrets, set in the Cloudflare dashboard (never in this file):
  //   TURNSTILE_SECRET, DOWNLOAD_SIGNING_KEY
  // Custom domains are added once timothygaull.com is on Cloudflare:
  // "routes": [
  //   { "pattern": "timothygaull.com", "custom_domain": true },
  //   { "pattern": "www.timothygaull.com", "custom_domain": true }
  // ]
}
